BILETFLOW_PAYMENTS_HALYK_CLIENT_SECRET=''
BILETFLOW_PAYMENTS_HALYK_TERMINAL_ID='67e34d63-102f-4bd1-898e-370781d0074d'

# dev.sh init appends a generated key. Keep that key across server restarts.
BILETFLOW_PAYMENTS_SESSION_ENCRYPTION_KEY=''
BILETFLOW_PAYMENTS_PUBLIC_BASE_URL='http://localhost:8080'
BILETFLOW_PAYMENTS_RETURN_URL='http://localhost:9090/halyk-sandbox-checkout.html'

# Mailpit from src/main/docker/services.yml
SPRING_MAIL_HOST='localhost'
