<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="20261124100000-organizer-profile" author="biletflow">
        <createTable tableName="iam_organizer_profile">
            <column name="organizer_id" type="bigint"><constraints primaryKey="true" nullable="false"/></column>
            <column name="organization_name" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="contact_name" type="varchar(120)"/>
            <column name="contact_email" type="varchar(254)"/>
            <column name="contact_phone" type="varchar(30)"/>
            <column name="website" type="varchar(512)"/>
            <column name="address" type="varchar(512)"/>
            <column name="description" type="varchar(2000)"/>
            <column name="updated_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="iam_organizer_profile" baseColumnNames="organizer_id"
            referencedTableName="jhi_user" referencedColumnNames="id" constraintName="fk_iam_organizer_profile_user" onDelete="CASCADE"/>
    </changeSet>
    <changeSet id="20261124100000-refund-policy" author="biletflow">
        <createTable tableName="oc_refund_policy">
            <column name="event_id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="organizer_id" type="bigint"><constraints nullable="false"/></column>
            <column name="refunds_allowed" type="boolean" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="cutoff_hours_before_event" type="int" defaultValueNumeric="24"><constraints nullable="false"/></column>
            <column name="updated_at" type="timestamp with time zone"><constraints nullable="false"/></column>
            <column name="version" type="bigint" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="oc_refund_policy" indexName="idx_oc_refund_policy_organizer">
            <column name="organizer_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
